{
  "manifest_version": 3,
  "name": "Unbook",
  "version": "1.0.0",
  "description": "Removes the distracting Facebook button from Messenger. Minimal, private, and set-and-forget.",
  "minimum_chrome_version": "105",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.messenger.com/*",
        "https://messenger.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
